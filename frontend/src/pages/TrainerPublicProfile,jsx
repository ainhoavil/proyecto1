// @ts-nocheck
import { useEffect, useState } from "react";
import { useParams, useNavigate } from "react-router-dom";
import { http } from "../helpers/http";
import "../styles/trainer-public-profile.scss";

export default function TrainerPublicProfile() {
  const { id } = useParams();
  const navigate = useNavigate();

  const [trainer, setTrainer] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    const loadTrainer = async () => {
      try {
        setLoading(true);
        setError("");

        const data = await http(`/api/trainers/${id}/profile`);
        setTrainer(data);
      } catch (e) {
        setError("No se pudo cargar el perfil del adiestrador");
      } finally {
        setLoading(false);
      }
    };

    loadTrainer();
  }, [id]);

  if (loading) return <p>Cargando perfil…</p>;
  if (error) return <p>{error}</p>;
  if (!trainer) return <p>Adiestrador no encontrado</p>;

  const nombre = trainer.displayName || trainer.email || `Adiestrador ${id}`;

  const handleContratar = () => {
    navigate(`/contratar?trainerId=${id}`);
  };

  return (
    <div className="trainer-public-profile card">
      <h1>{nombre}</h1>

      {trainer.photoUrl && (
        <div style={{ marginTop: 16 }}>
          <img
            src={trainer.photoUrl}
            alt={nombre}
            style={{ maxWidth: 300, width: "100%", borderRadius: 12 }}
          />
        </div>
      )}

      {trainer.experienceYears !== null &&
        trainer.experienceYears !== undefined && (
          <p style={{ marginTop: 16 }}>
            {trainer.experienceYears} años de experiencia
          </p>
        )}

      {Array.isArray(trainer.specialties) && trainer.specialties.length > 0 && (
        <div style={{ marginTop: 16 }}>
          <h3>Especialidades</h3>
          <ul>
            {trainer.specialties.map((s, i) => (
              <li key={i}>{s}</li>
            ))}
          </ul>
        </div>
      )}

      <div style={{ marginTop: 24 }}>
        <button className="btn-primary" onClick={handleContratar}>
          Contratar con este adiestrador
        </button>
      </div>
    </div>
  );
}
